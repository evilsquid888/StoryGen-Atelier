PORT=3005

# ── xAI Grok (text + image + video) ────────────────────────────────────
# Create a key at https://console.x.ai. One key drives everything.
XAI_API_KEY=your_xai_api_key_here
# Override only if you route through a proxy; default is https://api.x.ai/v1
XAI_BASE_URL=

# Text: storyboard scripts + transition analysis (Responses API).
XAI_TEXT_MODEL=grok-4.6

# Image: storyboard frames (Grok Imagine). Resolution: 1k or 2k.
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_IMAGE_RESOLUTION=1k

# Video: transition clips (Grok Imagine Video). Resolution: 480p / 720p / 1080p.
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_VIDEO_RESOLUTION=720p
XAI_VIDEO_ASPECT_RATIO=16:9
# Set to "false" to generate silent clips.
XAI_VIDEO_GENERATE_AUDIO=true

# Optional: default look applied when the UI does not pass a style.
IMAGE_STYLE=
